{
  "name": "spawnpad",
  "version": "0.1.0",
  "private": true,
  "description": "Spawnpad (spawn.fun) — Pump.fun V2-style Solana launchpad where every token mint ends in Spw",
  "scripts": {
    "postinstall": "npm run build --prefix packages/vanity-grinder",
    "build:grinder": "npm run build --prefix packages/vanity-grinder",
    "build:program": "anchor build",
    "sync:keypair": "node scripts/sync-keypair.mjs",
    "deploy:prepare": "npm run build:program && npm run sync:keypair",
    "anchor-test": "ts-mocha -p ./tsconfig.json -t 1000000 tests/**/*.ts",
    "test:program": "anchor test --skip-build",
    "test:rust": "cargo test --manifest-path programs/spawnpad-engine/Cargo.toml",
    "test:grinder": "npm test --prefix packages/vanity-grinder",
    "test": "npm run test:grinder && npm run test:rust && npm run deploy:prepare && npm run test:program"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@solana/spl-token": "^0.4.6",
    "@solana/web3.js": "^1.95.3",
    "@spawnpad/vanity-grinder": "file:packages/vanity-grinder"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^22.7.0",
    "chai": "^4.4.1",
    "mocha": "^10.4.0",
    "playwright": "^1.64.1",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
