{
  "compilerOptions": {
    "types": ["mocha", "node"],
    "lib": ["ES2021"],
    "target": "ES2021",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "tests/**/*.ts",
    "web/lib/server/tx-inspect.ts",
    "web/lib/server/metadata-tlv.ts",
    "web/lib/server/store.ts",
    "web/lib/launch/feed-filter.ts",
    "web/lib/launch/register.ts",
    "web/lib/config.ts"
  ]
}
