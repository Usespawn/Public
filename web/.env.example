# SpawnPad environment template — copy to .env.local and fill in real values.
# NEVER commit real keys. Server-only secrets must NOT use the NEXT_PUBLIC_
# prefix. THIS FILE IS SAFE TO COMMIT: it contains no real credentials.
#
# Visibility rules:
#   NEXT_PUBLIC_* = value is embedded in the browser bundle (public).
#   no prefix     = server-only; read exclusively by server-side modules.
#
# Variable names below are verified against the actual source code
# (lib/config.ts, lib/metadata/*, lib/server/*, components/WalletProviders.tsx).
# RESERVED entries are NOT read by the current build — keep them commented
# out until the code actually reads them.

# ============ 1. NETWORK CONFIGURATION ============

# Target Solana cluster: devnet | mainnet | mainnet-beta | localnet.
# Read by lib/config.ts getNetwork() — the single resolver shared by the
# browser wallet adapter (components/WalletProviders.tsx), every
# new Connection() site, and server-side verification (lib/server/verify.ts).
# Unrecognised values fall back to devnet (fail-closed).
# NOTE: "mainnet" and "mainnet-beta" both select Mainnet; "mainnet" also
# renders the Topbar network badge correctly (Topbar.tsx compares "mainnet").
NEXT_PUBLIC_NETWORK=devnet

# Solana RPC endpoint for the selected cluster. Optional: when empty, the app
# uses the official public cluster endpoint of the selected network
# (e.g. https://api.mainnet-beta.solana.com) — functional but rate-limited.
# For Mainnet use a provider endpoint (Helius free tier: https://helius.dev).
# The SAME endpoint serves the browser wallet, the launch transaction flow,
# and server-side verification — it must belong to the SAME cluster as
# NEXT_PUBLIC_NETWORK. A mismatch makes launches verify against the wrong
# chain. Verify cluster identity after any change with (read-only, no secrets):
#   node scripts/rpc-check.cjs   (getGenesisHash-based, from the spawnpad root)
# Mainnet-beta genesis reference:  5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp
# Devnet genesis reference:        EtWTRABZaYq6iMfeYKouRu166VU2xqa1
# SECURITY: NEXT_PUBLIC_ exposes the ENTIRE URL — including any embedded API
# key — to every browser visitor. Restrict the key at the provider
# (allowed origins + low rate limits). A zero-exposure alternative is a
# server-side proxy route, not implemented in the current build.
NEXT_PUBLIC_SOLANA_RPC=

# WebSocket RPC endpoint. NOT READ by the current build (no WebSocket code
# exists; transaction confirmation uses HTTP getSignatureStatuses polling).
# RESERVED.
# NEXT_PUBLIC_SOLANA_WS_RPC=

# ============ 2. TOKEN IMAGE AND METADATA — PINATA (server-only) ============

# SERVER-ONLY secret. JWT used by lib/metadata/pinata.ts (imported solely by
# the server API routes /api/metadata/upload and /api/metadata/json) to upload
# token images and metadata JSON to the PUBLIC IPFS network via the Pinata
# Files API v3 (POST https://uploads.pinata.cloud/v3/files, network=public,
# cid_version=v1). Obtain at pinata.cloud -> Account Settings -> API Keys ->
# New Key -> grant the files:write permission. Missing -> upload API returns
# 503 "not configured"; invalid -> clean 401 credential error. The JWT is
# never logged, never returned to the browser, never in a client bundle.
PINATA_JWT=

# Public IPFS gateway host/URL used to build resolvable https URLs for
# uploaded content (lib/metadata/upload.ts buildImageGatewayUrl). Accepts a
# bare host or full URL; a trailing /ipfs path is stripped automatically.
# Example: https://gateway.pinata.cloud  (or ipfs.io). Not a secret.
PINATA_GATEWAY=https://gateway.pinata.cloud

# ============ 3. PUMP.FUN ============
# No credentials and no environment variables: @pump-fun/pump-sdk builds the
# create_v2 transaction locally (lib/launch/launch.ts) and submits it via the
# Solana RPC. The pump.fun program ID, Token-2022 program ID and
# associated-token program ID are hardcoded constants in lib/config.ts
# (by design — a configurable program ID could be swapped for a fake one).
# The SDK requires no API key.

# ============ 4. APPLICATION URL — ONLY IF IMPLEMENTED ============

# RESERVED — not read by any current code path (planned share/OG links).
# NEXT_PUBLIC_APP_URL=

# ============ 5. DATABASE — ONLY IF IMPLEMENTED ============

# RESERVED — the current build persists verified launches to a local JSON
# file (web/.data/launches.json, lib/server/store.ts). The store schema is
# stable for a later Postgres/Supabase swap. Uncomment only when a real
# database client is added to the code.
# DATABASE_URL=

# ============ 6. MARKET DATA — ONLY IF IMPLEMENTED ============

# RESERVED — no market-data provider module exists in the current build
# (charts render on-chain data). Add credentials only when a provider module
# is implemented. MARKET_DATA_API_KEY must remain server-only.
# MARKET_DATA_PROVIDER=
# MARKET_DATA_API_KEY=

# ============ 7. OTHER SERVER-SIDE SECRETS — ONLY IF IMPLEMENTED ============

# RESERVED — no auth/session layer exists in the current build; API rate
# limiting is in-memory per IP (web/app/api/*). Uncomment only when the code
# reads it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SERVER_API_SECRET=
